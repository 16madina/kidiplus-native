{
  "expo": {
    "name": "KiDi+",
    "slug": "kidiplus-native",
    "scheme": "kidiplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10162B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidiplus.native",
      "bitcode": false,
      "infoPlist": {
        "CFBundleDisplayName": "KiDi+",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "KiDi+ utilise la caméra pour tes lives.",
        "NSMicrophoneUsageDescription": "KiDi+ utilise le micro pour tes lives."
      }
    },
    "android": {
      "package": "com.kidiplus.native",
      "adaptiveIcon": {
        "backgroundColor": "#10162B",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#10162B"
    },
    "plugins": [
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10162B",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiDi+ accède à tes photos pour la boutique, la bannière et la couverture des lives."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "livekit-react-native",
              "livekit-react-native-webrtc"
            ]
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives."
        }
      ],
      "./plugins/withLiveKitIos.js",
      "./plugins/withStatusBarPlist.js"
    ]
  }
}
