{
  "expo": {
    "name": "KiDi+",
    "slug": "kidiplus-native",
    "scheme": "kidiplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10162B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidiplus.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bitcode": false,
      "infoPlist": {
        "CFBundleDisplayName": "KiDi+",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "KiDi+ utilise la caméra pour tes lives.",
        "NSMicrophoneUsageDescription": "KiDi+ utilise le micro pour tes lives.",
        "NSFaceIDUsageDescription": "KiDi+ utilise Face ID pour déverrouiller l'app.",
        "NSUserTrackingUsageDescription": "KiDi+ utilise un identifiant pour améliorer ton expérience et les publicités.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"],
        "SCCameraKitAPIToken": "eyJhbGciOiJIUzI1NiIsImtpZCI6IkNhbnZhc1MyU0hNQUNQcm9kIiwidHlwIjoiSldUIn0.eyJhdWQiOiJjYW52YXMtY2FudmFzYXBpIiwiaXNzIjoiY2FudmFzLXMyc3Rva2VuIiwibmJmIjoxNzg0MDQzNzkxLCJzdWIiOiIxOWJhOGM5OC1jMDRhLTRlOTgtOGVkYi04YWM4ZDQyODUzMzN-UFJPRFVDVElPTn43OTRjMjZhNC02ZDg0LTQ5NGYtOGE4Ny04MmZkMmVkZDVmYTUifQ.YE50FTWYfbngNKJGigMDb-I_eVvfASwRF9NRsQ4MD_4",
        "SCCameraKitLensGroupID": "df287f43-6646-4b01-a711-1a0e632c211a"
      }
    },
    "android": {
      "package": "com.kidiplus.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#10162B",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#10162B"
    },
    "plugins": [
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10162B",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiDi+ accède à tes photos pour la boutique, la bannière et la couverture des lives."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "networkInspector": false,
            "forceStaticLinking": [
              "livekit-react-native",
              "livekit-react-native-webrtc"
            ]
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives."
        }
      ],
      "./plugins/withLiveKitIos.js",
      "./plugins/withStatusBarPlist.js",
      "./plugins/withCameraKit.js",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kidiplus.app",
          "enableGooglePay": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10162B",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-apple-authentication",
      "expo-local-authentication",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "KiDi+ utilise un identifiant pour améliorer ton expérience et les publicités."
        }
      ]
    ]
  }
}
