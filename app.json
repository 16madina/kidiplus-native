    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#10162B"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": true
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10162B",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiDi+ accède à tes photos pour la boutique, la bannière et la couverture des lives."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "networkInspector": false,
            "forceStaticLinking": [
              "livekit-react-native",
              "livekit-react-native-webrtc"
            ]
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      "./plugins/withLiveKitAudioSwitch.js",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "KiDi+ utilise la caméra pour tes lives.",
          "microphonePermission": "KiDi+ utilise le micro pour tes lives."
        }
      ],
      "./plugins/withLiveKitIos.js",
      "./plugins/withStatusBarPlist.js",
      "./plugins/withCameraKit.js",
      "./plugins/withPictureInPicture.js",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kidiplus.app",
          "enableGooglePay": false
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
